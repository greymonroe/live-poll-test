// Security rules for live-poll-test.
//
// Paste into Firebase console → Realtime Database → Rules → Publish.
// Keep this file in sync: it is the source of truth, the console is just where
// it runs. Full setup walkthrough in SECURITY.md.
//
// Identities:
//   students — anonymous auth (no prompt, no credential, no PII)
//   host     — Google auth; the host uid lives at admin/hostUid, claimable once
//
// What these rules guarantee:
//   - unauthenticated callers can read nothing but poll/quiz question text
//   - a student can read ONLY their own player record and their own answers
//   - a student can write ONLY their own display name and one answer per
//     question (server-enforced first-answer-wins, not a localStorage guard)
//   - answer timestamps are server-stamped, so the speed bonus can't be forged
//   - the answer key (quizzes/<id>/key) is readable by the host alone
//   - only the host can score, read the roster, or delete anything
{
  "rules": {
    ".read": false,
    ".write": false,

    // Claim-once host identity. Requires Google sign-in, so the claim can't be
    // taken by a student on an anonymous session. Immutable from the client
    // afterwards — to move it, edit the value in the console Data tab.
    "admin": {
      "hostUid": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && auth.token.firebase.sign_in_provider === 'google.com'",
        ".validate": "newData.isString() && newData.val() === auth.uid"
      }
    },

    "polls": {
      // index.html lists every poll; any signed-in device may read.
      // Poll responses carry no identity, so this is not a privacy surface.
      ".read": "auth != null",

      "$pid": {
        // Clear results / delete poll.
        ".write": "auth != null && root.child('admin/hostUid').val() === auth.uid",

        "config": {
          // Public read so newpoll.py's "does this id already exist?" check
          // works over plain REST. Question text only — no identity.
          ".read": true,
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['type', 'question'])",
          "type":     { ".validate": "newData.isString()" },
          "question": { ".validate": "newData.isString() && newData.val().length <= 500" },
          "options":  { ".validate": "newData.hasChildren()" },
          "created":  { ".validate": "newData.isNumber()" },
          "$other":   { ".validate": false }
        },

        "responses": {
          "$rid": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChild('ts') && (newData.hasChild('text') || newData.hasChild('choice'))",
            "text":   { ".validate": "newData.isString() && newData.val().length <= 300" },
            "choice": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 20" },
            "ts":     { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "quizzes": {
      ".read": "auth != null && root.child('admin/hostUid').val() === auth.uid",

      "$qid": {
        ".read":  "auth != null && root.child('admin/hostUid').val() === auth.uid",
        ".write": "auth != null && root.child('admin/hostUid').val() === auth.uid",

        // Question text and options. No answer key here — see "key" below.
        "config": {
          ".read": true,
          ".write": "!data.exists()",
          ".validate": "newData.hasChild('questions')"
        },

        // The answer key. Written once by newquiz.py, then host-read only.
        // Players never receive it; the host publishes the correct index into
        // state.correct at reveal time.
        "key": {
          ".write": "!data.exists()"
        },

        // Host-written game state: phase, question index, startedAt, and at
        // reveal/leaderboard time the correct index, player count, and a
        // uid→{rank,score} results map. Never contains names.
        "state": {
          ".read": "auth != null"
        },

        "players": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",

            // The only thing a student may write about themselves.
            "name": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
            },
            // Host-written (the $qid .write above covers it).
            "score":   { ".validate": "newData.isNumber()" },
            "rank":    { ".validate": "newData.isNumber()" },
            "awarded": { "$q": { ".validate": "newData.isNumber()" } },
            "$other":  { ".validate": false }
          }
        },

        "answers": {
          "$q": {
            "$uid": {
              ".read":  "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid && !data.exists()",
              ".validate": "newData.hasChildren(['choice', 'ts'])",
              "choice": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
              "ts":     { ".validate": "newData.val() === now" },
              "$other": { ".validate": false }
            }
          }
        }
      }
    },

    // Soil Report (repo em-soil-map). One sample per student, from anonymous
    // sessions. Full-precision location (Grey 2026-10-06: no privacy concern).
    //   config                 host only
    //   samples/<id>           create-only by any signed-in device; stores the
    //                          creator's anonymous uid so only that phone can
    //                          write samples/<id>/reflect (editable) and photos.
    //   photos/<id>/<slot>     JPEG <= ~380 KB each, create-only, host-read only
    "soil": {
      "$sid": {
        ".write": "auth != null && root.child('admin/hostUid').val() === auth.uid",
        "config": { ".read": true },
        "samples": {
          ".read": "auth != null",
          "$id": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['uid', 'group', 'label', 'lat', 'lng', 'ts'])",
            "uid":      { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "group":    { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 6" },
            "label":    { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
            "lat":      { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
            "lng":      { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
            "locSource": { ".validate": "newData.isString() && newData.val().matches(/^(gps|map|typed)$/)" },
            "place": { ".validate": "newData.isString() && newData.val().matches(/^(garden|yard|park|school|farm|roadside|creek|potting|wild|other)$/)" },
            "site":     { ".validate": "newData.isString() && newData.val().length <= 300" },
            "color": { ".validate": "newData.isString() && newData.val().matches(/^(black|vdarkbrown|darkbrown|brown|lightbrown|pale|reddish|red|yellowish|gray|bluegray)$/)" },
            "ball": { ".validate": "newData.isString() && newData.val().matches(/^(yes|no)$/)" },
            "ribbon": { ".validate": "newData.isString() && newData.val().matches(/^(none|short|medium|long)$/)" },
            "grit": { ".validate": "newData.isString() && newData.val().matches(/^(gritty|smooth|neither)$/)" },
            "texture": { ".validate": "newData.isString() && newData.val().matches(/^(sand|loamy sand|sandy loam|loam|silt loam|silt|sandy clay loam|clay loam|silty clay loam|sandy clay|silty clay|clay|unsure)$/)" },
            "structure": { ".validate": "newData.isString() && newData.val().matches(/^(granular|blocky|platy|single|massive)$/)" },
            "moisture": { ".validate": "newData.isString() && newData.val().matches(/^(dry|moist|wet)$/)" },
            "roots": { ".validate": "newData.isString() && newData.val().matches(/^(none|few|many)$/)" },
            "organic": { ".validate": "newData.isString() && newData.val().matches(/^(none|some|lots)$/)" },
            "rocks": { ".validate": "newData.isString() && newData.val().matches(/^(none|some|lots)$/)" },
            "smell": { ".validate": "newData.isString() && newData.val().matches(/^(earthy|none|sour|musty)$/)" },
            "critters": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 999" },
            "critterKinds": { ".validate": "newData.isString() && newData.val().length <= 100 && newData.val().matches(/^[a-z,]*$/)" },
            "phV":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 14" },
            "phKit": { ".validate": "newData.isString() && newData.val().matches(/^(strip|tube|dropper|other)$/)" },
            "nL":   { ".validate": "newData.isString() && newData.val().matches(/^(vlow|low|med|high|vhigh)$/)" },
            "nV":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2000" },
            "nKit": { ".validate": "newData.isString() && newData.val().matches(/^(strip|tube|dropper|other)$/)" },
            "pL":   { ".validate": "newData.isString() && newData.val().matches(/^(vlow|low|med|high|vhigh)$/)" },
            "pV":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2000" },
            "pKit": { ".validate": "newData.isString() && newData.val().matches(/^(strip|tube|dropper|other)$/)" },
            "kL":   { ".validate": "newData.isString() && newData.val().matches(/^(vlow|low|med|high|vhigh)$/)" },
            "kV":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2000" },
            "kKit": { ".validate": "newData.isString() && newData.val().matches(/^(strip|tube|dropper|other)$/)" },
            "nh3L":   { ".validate": "newData.isString() && newData.val().matches(/^(vlow|low|med|high|vhigh)$/)" },
            "nh3V":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2000" },
            "nh3Kit": { ".validate": "newData.isString() && newData.val().matches(/^(strip|tube|dropper|other)$/)" },
            "photos":   { ".validate": "newData.isString() && newData.val().length <= 60 && newData.val().matches(/^[a-z0-9,]*$/)" },
            "dbMap":     { ".validate": "newData.isString() && newData.val().length <= 120" },
            "dbSeries":  { ".validate": "newData.isString() && newData.val().length <= 60" },
            "dbTexture": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "dbDrain":   { ".validate": "newData.isString() && newData.val().length <= 40" },
            "dbOrder":   { ".validate": "newData.isString() && newData.val().length <= 30" },
            "dbPh":      { ".validate": "newData.isNumber()" },
            "dbOm":      { ".validate": "newData.isNumber()" },
            "dbClay":    { ".validate": "newData.isNumber()" },
            "ts":       { ".validate": "newData.val() === now" },
            // Reflection answers, typed after the report card. Only the phone
            // that created the sample may write (and re-write) them.
            "reflect": {
              ".write": "auth != null && data.parent().child('uid').val() === auth.uid",
              ".validate": "newData.hasChild('ts')",
              "r1": { ".validate": "newData.isString() && newData.val().length <= 600" },
              "r2": { ".validate": "newData.isString() && newData.val().length <= 600" },
              "r3": { ".validate": "newData.isString() && newData.val().length <= 600" },
              "r4": { ".validate": "newData.isString() && newData.val().length <= 600" },
              "ts": { ".validate": "newData.val() === now" },
              "$other": { ".validate": false }
            },
            "$other":   { ".validate": false }
          }
        },
        "photos": {
          ".read": "auth != null && root.child('admin/hostUid').val() === auth.uid",
          "$id": {
            "$slot": {
              ".write": "auth != null && !data.exists() && root.child('soil').child($sid).child('samples').child($id).child('uid').val() === auth.uid",
              ".validate": "$slot.matches(/^(soil|ph|n|p|k|nh3)$/) && newData.hasChildren(['data'])",
              "data":   { ".validate": "newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length <= 400000" },
              "$other": { ".validate": false }
            }
          }
        }
      }
    },

    // Campus Census (repo em-campus-census). Field-survey observations from
    // anonymous student sessions. No names, no accounts: team name + species.
    //   config        written by the host / admin script only
    //   obs/<id>      create-only by any signed-in device; only the host deletes.
    //                 No uid is stored, so nothing links one phone's entries.
    //   photos/<id>   the photo for obs <id>, create-only, host-read only, <= ~380 KB
    "census": {
      "$sid": {
        ".write": "auth != null && root.child('admin/hostUid').val() === auth.uid",
        "config": { ".read": true },
        // groups/<n>: the first phone to pick group n names it (create-only);
        // everyone after joins it. Group n is assigned zone n (zones.geojson).
        "groups": {
          ".read": "auth != null",
          "$g": {
            ".write": "auth != null && !data.exists()",
            ".validate": "$g.matches(/^([1-9]|1[0-2])$/) && newData.hasChildren(['name', 'zone', 'ts'])",
            "name":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
            "zone":   { ".validate": "newData.isString() && newData.val().length <= 40" },
            "ts":     { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        },
        "obs": {
          ".read": "auth != null",
          "$oid": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['team', 'kind', 'name', 'count', 'ts'])",
            "team":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
            "kind":     { ".validate": "newData.isString() && newData.val().matches(/^(plant|insect|bird|animal|squirrel|turkey)$/)" },
            "name":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
            "count":    { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 500" },
            "sci":      { ".validate": "newData.isString() && newData.val().length <= 120" },
            "taxonId":  { ".validate": "newData.isNumber()" },
            "zone":     { ".validate": "newData.isString() && newData.val().length <= 40" },
            "lat":      { ".validate": "newData.isNumber() && newData.val() > 38.4 && newData.val() < 38.7" },
            "lng":      { ".validate": "newData.isNumber() && newData.val() > -121.9 && newData.val() < -121.6" },
            "hasPhoto": { ".validate": "newData.isBoolean()" },
            "acc":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
            "group":    { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12" },
            "assignedZone": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "zoneSource":   { ".validate": "newData.val() === 'gps' || newData.val() === 'pin' || newData.val() === 'assigned'" },
            "locSource":    { ".validate": "newData.val() === 'gps' || newData.val() === 'pin'" },
            "ts":       { ".validate": "newData.val() === now" },
            "$other":   { ".validate": false }
          }
        },
        "photos": {
          ".read": "auth != null && root.child('admin/hostUid').val() === auth.uid",
          "$oid": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['data'])",
            "data":   { ".validate": "newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length <= 400000" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
